# Prefer env vars for secrets in production:
#   DISTCORE_DMS_USERNAME
#   DISTCORE_DMS_PASSWORD
#   DISTCORE_DMS_AUTH=ntlm   # optional: auto | ntlm | sspi | basic
#   DISTCORE_DMS_CONFIG=/path/to/dms.yml

