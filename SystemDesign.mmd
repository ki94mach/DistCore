graph TB

  subgraph Sources["External data sources"]
    direction TB

    subgraph DWOrchid["DWOrchid · source connection"]
      direction TB
      FactInv["dbo.FactInventory"]
      FlatSale["dbo.Flat_Fact_Sale"]
      FactTarget["dbo.FactTarget"]
      dims["Data.DimDate · DimProduct · DimDistrbutor"]
    end

    subgraph DMS["DMS SharePoint"]
      DelFiles["Delivery Excel 1404 + 1405"]
    end
  end

  subgraph Orchestrator["ETL · Python pipeline_cli"]
    direction TB
    P1["Factory Inventory"]
    P2["Distributor Inventory"]
    P3["Sales Snapshot"]
    P4["Target"]
    P5["Distributor Deliveries"]
  end

  subgraph ProdDB["Iris_DW · prod connection · schema Sale"]
    direction TB
    ctl[ctl_BatchRun]
    factDel[fact_DistributorDeliveries]
    snp[snp_* x5 snapshots]
  end

  subgraph Optimization["Optimization"]
    Loader[SnapshotDataLoader]
    Solvers[LP / MILP / CP-SAT]
    Loader --> Solvers
  end

  FactInv -->|"publish procs"| P1 & P2
  FlatSale --> P3
  FactTarget --> P4
  DelFiles --> P5
  P5 --> factDel

  P1 & P2 & P3 & P4 -->|"EXEC etl_usp_build_*"| snp
  P5 -->|"publish"| snp
  dims -->|"cross-DB joins in procs"| snp

  snp --> Loader
