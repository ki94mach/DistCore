graph LR

  %% 1. Data sources
  subgraph Sources["Data sources"]
    direction TB
    HDI["Historical Distrubutor Inventory<br> [DWOrchid].[dbo].[FactInventoryHistorical]"]
    CFI["Current Factory Inventory<br> [DWOrchid].[dbo].[FactFactoryInventory]"]
    CMS["Current Month Sales<br>[DWOrchid].[dbo].[Flat_Fact_Sale]"]
    SH6M["Sales History (Last 6 Months) <br> [DWOrchid].[dbo].[Flat_Fact_Sale]"]
    DT["Distributor Target<br> [Iris_DW].[import].[Data0_Main_SC_Distributors_Target_Template]"]
    PT["Product Target<br>SQL Server: [DWOrchid].[dbo].[FactTarget]"]
  end

  %% 2. Data & snapshot layer
  subgraph Data["Data & snapshot layer"]
    direction TB
    Ingest["ELT + validation"]
    DWH["Data Warehouse"]
    Snap["Snapshot Builder<br>As-of dataset + derived metrics<br>(MA sales, MA deliveries, 6m flags)"]
  end

  %% 3. Policy & governance
  subgraph Policy["Policy & governance"]
    direction LR
    Config["Versioned config repo"]
    PolicySvc["Policy/Rules Service\ncoefficients, hard/soft flags,\npenalties, exceptions, calendars"]
  end

  %% 4. Optimization layer
  subgraph Solve["Optimization layer"]
    direction TB
    OptAPI["Optimization Orchestrator API"]
    Workers["Solver workers\nLP/MILP/CP-SAT"]
    RunDB["Run Registry + Audit"]
  end

  %% 5. Planning & execution
  subgraph Plan["Planning & execution"]
    direction LR
    UI["Planner UI\nreview / what-if / override"]
    Approvals["Approval workflow"]
    Exec["Execution adapter\nERP orders / ASN / transfers"]
    Monitor["Monitoring + Alerts"]
  end

  %% Data flow from individual sources
  HDI --> Ingest
  CFI --> Ingest
  CMS --> Ingest
  DT --> Ingest
  PT --> Ingest
  SH6M --> Ingest
  Ingest --> DWH
  DWH --> Snap

  %% Policy config
  Config --> PolicySvc

  %% Optimization
  Snap --> OptAPI
  PolicySvc --> OptAPI
  OptAPI --> Workers
  Workers --> RunDB

  %% Planning & execution
  OptAPI --> UI
  UI --> Approvals
  Approvals --> Exec
  Exec --> Monitor
  Approvals --> RunDB
